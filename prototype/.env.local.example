# Copy this file to .env.local and fill in the values yourself (never commit .env.local,
# never paste keys into chat). Values come from Supabase Dashboard → Project Settings → API Keys.

# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) — or the legacy "anon" key if the project only shows that
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) — or the legacy "service_role" key. Server-only: no NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Used only by local scripts (npm run demo:accounts / demo:reset / demo:verify), not by the app.
# Demo password + PIN are the ones written in README for reviewers; test password stays private.
DEMO_ACCOUNT_PASSWORD=
DEMO_ACCOUNT_PIN=
TEST_ACCOUNT_PASSWORD=
